      "Code": "//Aantal weggeschreven rijen naar CSV\nResult;"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# Voeg de benodigde AutoCAD references toe\r\nclr.AddReference('AcMgd')\r\nclr.AddReference('AcCoreMgd')\r\nclr.AddReference('AcDbMgd')\r\n\r\nfrom Autodesk.AutoCAD.ApplicationServices import Application\r\nfrom Autodesk.AutoCAD.DatabaseServices import OpenMode\r\n\r\n# Haal het actieve document en de database op\r\nadoc = Application.DocumentManager.MdiActiveDocument\r\ndb = adoc.Database\r\n\r\ngo = IN[0]\r\nlayer_names = []\r\n\r\nif go:\r\n    # Zorg ervoor dat het document gelocked is voordat je de database uitleest\r\n    with adoc.LockDocument():\r\n        # Start een transactie\r\n        with db.TransactionManager.StartTransaction() as t:\r\n            # Open de Layer Table met leesrechten\r\n            layer_table = t.GetObject(db.LayerTableId, OpenMode.ForRead)\r\n            \r\n            # Loop door alle lagen in de tabel\r\n            for layer_id in layer_table:\r\n                layer = t.GetObject(layer_id, OpenMode.ForRead)\r\n                layer_names.append(layer.Name)\r\n                \r\n            t.Commit()\r\n    \r\n    # Stuur de lijst met laagnamen naar de output van de node\r\n    OUT = layer_names\r\n    \r\nelse:\r\n    OUT = 0",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "6b3330e4be964a53ace15781cb427dd6",
      "NodeType": "PythonScriptNode",
