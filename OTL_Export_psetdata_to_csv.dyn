      "Outputs": [
        {
          "Id": "59011a32c06d470bbc6f3f689a4b5d7c",
          "Name": "layerlijst",
          "Description": "layerlijst = DesignScript.Builtin.Get.ValueAtIndex(out, 0)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "73cbf51e6e364245a8773ddb2dc666f6",
          "Name": "currentdoc",
          "Description": "currentdoc = DesignScript.Builtin.Get.ValueAtIndex(out, 1)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "layerlijst = out[0];\ncurrentdoc= out[1];"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# Laad de Dynamo AutoCAD API in\r\nclr.AddReference('AutoCADNodes')\r\nfrom Autodesk.AutoCAD.DynamoNodes import Document\r\n\r\nlayerlijst= IN[0]\r\n\r\nif layerlijst:\r\n    # Haal direct het actieve Dynamo-document op\r\n    dyn_doc = Document.Current\r\n    # Stuur het Dynamo-document naar de output\r\n    OUT = layerlijst, dyn_doc\r\n    \r\nelse:\r\n    OUT = [\"\",\"\"]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "48d7fe1adfad428ca365f14d1e63a1bb",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "9d771808018a45d6b2114874913b42c1",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "d4b2393fde154f0b8d940a8605b4f992",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport os\r\nimport ctypes\r\n\r\n\r\n#INPUT\r\ninput_file_of_folder = IN[0]\r\n\r\ngo = 0\r\nmessage = \"\"\r\nm = ctypes.windll.user32\r\nnl = '\\n'\r\n\r\n\r\nif input_file_of_folder:\r\n    if os.path.isdir(input_file_of_folder):#bij folder\r\n        message = f\"Correcte input, CSV bestanden worden geschreven in de folder: {nl}{str(input_file_of_folder)}\"\r\n        go = 1\r\n                \r\n    elif os.path.isfile(input_file_of_folder):#bij file\r\n        message = f\"Opgegeven pad is het pad naar een file: {nl}{str(input_file_of_folder)}{nl}{nl}Geef een folder waar de file mag worden geschreven,{nl}gebruik daarvoor de 'Directory Path' node\"\r\n        \r\n    else:\r\n        message = f\"Geen bruikbare input:{nl}{str(input_file_of_folder)}{nl}{nl}Geef een locatie op om de csv files naar te schrijven,{nl}gebruik daarvoor de 'Directory Path' node\"\r\n\r\nelse:\r\n    message = f\"Geen bruikbare input:{nl}{str(input_file_of_folder)}{nl}{nl}Geef een locatie op om de csv files naar te schrijven,{nl}gebruik daarvoor de 'Directory Path' node\"\r\n\r\nm.MessageBoxW(0, message, \"OTL_Export psetdata to CSV\", 0)\r\nOUT = go",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "b274d2c589c547c892779fbbcbfe83a7",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "263349b92aa14956a1a08942c3e9daab",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "e7601f22f5c247b7b2a47ac5c7f6ea2d",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
