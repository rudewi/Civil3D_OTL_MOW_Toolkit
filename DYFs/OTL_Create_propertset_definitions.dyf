    {
      "ConcreteType": "Dynamo.Graph.Nodes.CustomNodes.Output, DynamoCore",
      "ElementResolver": null,
      "Symbol": "//Aangemaakte propertysets\r\nPropertyset_Info;",
      "Id": "d02164c960aa423fb302582fc6f03048",
      "NodeType": "OutputNode",
      "Inputs": [
