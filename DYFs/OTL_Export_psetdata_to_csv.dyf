    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "004e8c1d447f4131800dd7993e21cfc7",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "db043ff119f04e49922f26d28eca007a",
          "Name": "string",
