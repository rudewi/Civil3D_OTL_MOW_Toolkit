          "Id": "164c77053e874b4ea5d88d46c7e33ae3",
          "Name": "layerlijst",
          "Description": "layerlijst = DesignScript.Builtin.Get.ValueAtIndex(out, 0)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e5d6ee9bc03349dcbb3f8563bc30e77d",
          "Name": "currentdoc",
          "Description": "currentdoc = DesignScript.Builtin.Get.ValueAtIndex(out, 1)",
          "UsingDefaultValue": false,
          "Level": 2,
