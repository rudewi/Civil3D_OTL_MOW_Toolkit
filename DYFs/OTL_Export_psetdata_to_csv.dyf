          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "layerlijst = out[0];\ncurrentdoc= out[1];"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# Laad de Dynamo AutoCAD API in\r\nclr.AddReference('AutoCADNodes')\r\nfrom Autodesk.AutoCAD.DynamoNodes import Document\r\n\r\nlayerlijst= IN[0]\r\n\r\nif layerlijst:\r\n    # Haal direct het actieve Dynamo-document op\r\n    dyn_doc = Document.Current\r\n    # Stuur het Dynamo-document naar de output\r\n    OUT = layerlijst, dyn_doc\r\n    \r\nelse:\r\n    OUT = [\"\",\"\"]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "1427a527450a43c88f298e3b4064f95f",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "9b95d14a28b844f7a3772f859aa7f442",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "d886f7b37c1c46c699fbf53d1c417db5",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport os\r\nimport ctypes\r\n\r\n\r\n#INPUT\r\ninput_file_of_folder = IN[0]\r\n\r\ngo = 0\r\nmessage = \"\"\r\nm = ctypes.windll.user32\r\nnl = '\\n'\r\n\r\n\r\nif input_file_of_folder:\r\n    if os.path.isdir(input_file_of_folder):#bij folder\r\n        message = f\"Correcte input, CSV bestanden worden geschreven in de folder: {nl}{str(input_file_of_folder)}\"\r\n        go = 1\r\n                \r\n    if os.path.isfile(input_file_of_folder):#bij file\r\n        message = f\"Opgegeven pad is het pad naar een file: {nl}{str(input_file_of_folder)}{nl}{nl}Geef een folder waar de file mag worden geschreven,{nl}gebruik daarvoor de 'Directory Path' node\"\r\n        \r\n    else:\r\n        message = f\"Geen bruikbare input:{nl}{str(input_file_of_folder)}{nl}{nl}Geef een locatie op om de csv files naar te schrijven,{nl}gebruik daarvoor de 'Directory Path' node\"\r\n\r\nelse:\r\n    message = f\"Geen bruikbare input:{nl}{str(input_file_of_folder)}{nl}{nl}Geef een locatie op om de csv files naar te schrijven,{nl}gebruik daarvoor de 'Directory Path' node\"\r\n\r\nm.MessageBoxW(0, message, \"OTL_Export psetdata to CSV\", 0)\r\nOUT = go",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "cb23715711fc42efa18521a13ebc5447",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "32b72e0a908c464ab8ca6b5b998a9346",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "996b5ded94e445a1b40c1e6aa33a8da9",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
