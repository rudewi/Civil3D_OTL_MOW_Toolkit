          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "//Aantal weggeschreven rijen naar CSV\nResult;"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# Voeg de benodigde AutoCAD references toe\r\nclr.AddReference('AcMgd')\r\nclr.AddReference('AcCoreMgd')\r\nclr.AddReference('AcDbMgd')\r\n\r\nfrom Autodesk.AutoCAD.ApplicationServices import Application\r\nfrom Autodesk.AutoCAD.DatabaseServices import OpenMode\r\n\r\n# Haal het actieve document en de database op\r\nadoc = Application.DocumentManager.MdiActiveDocument\r\ndb = adoc.Database\r\n\r\nlayer_names = []\r\n\r\n# Zorg ervoor dat het document gelocked is voordat je de database uitleest\r\nwith adoc.LockDocument():\r\n    # Start een transactie\r\n    with db.TransactionManager.StartTransaction() as t:\r\n        # Open de Layer Table met leesrechten\r\n        layer_table = t.GetObject(db.LayerTableId, OpenMode.ForRead)\r\n        \r\n        # Loop door alle lagen in de tabel\r\n        for layer_id in layer_table:\r\n            layer = t.GetObject(layer_id, OpenMode.ForRead)\r\n            layer_names.append(layer.Name)\r\n            \r\n        t.Commit()\r\n\r\n# Stuur de lijst met laagnamen naar de output van de node\r\nOUT = layer_names",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "d7ad6fe019d14863902893dafc679f30",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "439895f6ea28449cb193eee6e7ae11e9",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "0ec81966ab3f43609aacbcb6c095dc98",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    }
